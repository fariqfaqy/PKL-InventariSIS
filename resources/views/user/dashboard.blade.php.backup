        }

        .status-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .status-card {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            text-align: center;
        }

        .status-card.aman {
            border-top: 4px solid #4CAF50;
        }

        .status-card.menengah {
            border-top: 4px solid #FDD835;
        }

        .status-card.kritis {
            border-top: 4px solid #F44336;
        }

        .status-card .icon {
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .status-card.aman .icon {
            color: #4CAF50;
        }

        .status-card.menengah .icon {
            color: #FDD835;
        }

        .status-card.kritis .icon {
            color: #F44336;
        }

        .status-card .count {
            font-size: 2rem;
            font-weight: 700;
            margin: 10px 0;
        }

        .status-card .label {
            color: #666;
            font-size: 0.9rem;
        }

        .rack-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
        }

        .rack-card {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            color: inherit;
        }

        .rack-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(30, 136, 229, 0.3);
            border: 2px solid #1E88E5;
        }

        .rack-card .rack-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1E88E5;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .rack-card .rack-count {
            font-size: 1.2rem;
            color: #666;
        }

        @media (max-width: 768px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .status-grid {
                grid-template-columns: 1fr;
            }

            .rack-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }
    </style>
</head>
